{
  "name": "yiqikan",
  "version": "0.2.0",
  "private": true,
  "description": "异地恋一起看片小站：同步播放 + 屏幕共享 + 聊天 + 戳一戳",
  "engines": {
    "node": ">=16.17"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "lint": "eslint server shared web test --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx test/ws-test.ts",
    "push": "node scripts/push-via-api.mjs",
    "push:status": "node scripts/push-via-api.mjs status"
  },
  "dependencies": {
    "hls.js": "^1.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.3.0",
    "subset-font": "^2.7.0",
    "tsx": "^3.13.0",
    "typescript": "^5.3.0",
    "vite": "^4.5.0"
  }
}
